#!/bin/sh
# Publish one registry from the source repository that owns its packages.
# Usage: publish mycrates|mynpm|mypypi|oci [--promote=cf|s3] [--republish] [--allow-drops]
#   mycrates: CRATES="name-a name-b" publish mycrates
#   mynpm:    LOCKFILE=pnpm-lock.yaml PROJECT=project publish mynpm
#   mypypi:   PACKAGES="name==version" publish mypypi
#   oci:      OCI_IMAGES="repo=ref" publish oci  (or OCI_LAYOUT/OCI_REPOSITORY)
#
# The wrapper checks cf auth, adopts the live publication until the local
# state carries a completion marker, and then runs the matching publish
# helper. For mycrates it also adopts again, extending the state in place,
# whenever the live generation is not the one this machine last promoted or
# adopted, so another publisher's records are never left out.
# Promotion defaults to s3, a conditional write that gives a competing
# publisher 412. R2_S3_* is minted from cf when unset, and the wrapper fails
# before building if it cannot be.
# --promote=cf is the explicit opt-out: a plain put that does not detect a
# competing publisher.
# --republish adds no packages: it renders the live publication again under
# the current renderer and promotes it, so no package inputs are needed.
# --allow-drops lets the new generation remove versions the live catalog
# serves; without it r2-sync.sh refuses such a promotion.
set -eu
SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
STUFF_DIR=${STUFF_DIR:-$(cd "$SCRIPT_DIR/.." && pwd)}
export STUFF_DIR
. "$STUFF_DIR/deploy/publish-lock.sh"
. "$STUFF_DIR/deploy/r2-s3-credentials.sh"
H=${STUFF_STATE_HOME:-${XDG_STATE_HOME:-$HOME/.local/state}/stuff}
ADOPT_PULL=""
ADOPT_STATE_STAGE=""
ADOPT_STAGE=""

usage() {
  cat >&2 <<'EOF'
usage: publish mycrates|mynpm|mypypi|oci [--promote=cf|s3] [--republish] [--allow-drops]
  mycrates: CRATES="name-a name-b" publish mycrates
  mynpm:    LOCKFILE=pnpm-lock.yaml PROJECT=project publish mynpm
  mypypi:   PACKAGES="name==version" publish mypypi
  oci:      OCI_IMAGES="repo=ref ..." publish oci
            OCI_LAYOUT=DIR OCI_REPOSITORY=NAME [OCI_TAG=TAG] publish oci
EOF
}

fail() {
  echo "publish: $1" >&2
  exit 2
}

cleanup() {
  status=$?
  trap - EXIT
  [ -z "$ADOPT_PULL" ] || rm -rf "$ADOPT_PULL" || true
  [ -z "$ADOPT_STATE_STAGE" ] || rm -rf "$ADOPT_STATE_STAGE" || true
  if [ -n "$ADOPT_STAGE" ]; then
    if [ "$status" -eq 0 ]; then
      rm -rf "$ADOPT_STAGE" || true
    else
      echo "publish: adoption failed; staging is at $ADOPT_STAGE" >&2
      echo "publish: inspect it, then remove it with: rm -rf '$ADOPT_STAGE'" >&2
    fi
  fi
  exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

REGISTRY=${1:-}
case $REGISTRY in
  -h | --help)
    usage
    exit 0
    ;;
  mycrates | mynpm | mypypi | oci) ;;
  *) usage; exit 2 ;;
esac
shift
PROMOTE=s3
REPUBLISH=""
while [ $# -gt 0 ]; do
  case $1 in
    --republish)
      REPUBLISH=1
      shift
      ;;
    --promote=cf | --promote=s3)
      PROMOTE=${1#--promote=}
      shift
      ;;
    --allow-drops)
      export R2_ALLOW_DROPS=1
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      usage
      exit 2
      ;;
  esac
done

export REPUBLISH
command -v cf >/dev/null 2>&1 || fail "the cf CLI is not on PATH"
if [ -z "${CF_AUTH_CHECKED:-}" ]; then
  cf auth whoami 2>/dev/null | grep -q '"authenticated"[[:space:]]*:[[:space:]]*true' ||
    fail "cf is not authenticated; run cf auth login"
fi

case $PROMOTE in
  cf)
    export R2_PROMOTE_UNCONDITIONAL=1
    ;;
  s3)
    unset R2_PROMOTE_UNCONDITIONAL
    (mint_s3_credentials "stuff-$REGISTRY") ||
      fail "--promote=s3 needs R2_S3_* and minting them failed; mint them with: eval \"\$(python3 $SCRIPT_DIR/r2-temp-credentials.py stuff-$REGISTRY)\", or pass --promote=cf"
    ;;
esac

adopted_generation() {
  target=$(readlink "$1/current")
  printf '%s\n' "${target#generations/}"
}

live_generation() {
  cf r2 objects get current --text --bucket-name "$1" | tr -d '[:space:]'
}

adopt_locked() {
  acquire_publish_lock "$(bucket_lock_path "stuff-$REGISTRY")"
  "$@"
  release_publish_lock
}

adopt_marker() {
  printf 'adopted %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$1/.adopt-complete"
}

adopt_mycrates() {
  echo "publish: adopting the live mycrates publication into $STATE_DIR" >&2
  BIN=$STUFF_DIR/crates/mycrates/bin/mycrates
  mkdir -p "$H" "$(dirname "$STATE_DIR")"
  ADOPT_PULL=$(mktemp -d "$H/mycrates-adopt.XXXXXX")
  python3 "$STUFF_DIR/deploy/r2-pull.py" stuff-mycrates "$ADOPT_PULL"
  if [ -d "$STATE_DIR" ] && [ -n "$(ls -A "$STATE_DIR" 2>/dev/null)" ]; then
    echo "publish: extending $STATE_DIR in place with the live publication" >&2
    "$BIN" init --state-dir "$STATE_DIR" --site-dir "$ADOPT_PULL/site"
    "$BIN" config set-public-base-url "$PUBLIC_URL" --state-dir "$STATE_DIR"
    "$BIN" adopt --from-site "$ADOPT_PULL" --state-dir "$STATE_DIR"
    "$BIN" verify --state-dir "$STATE_DIR"
    adopt_marker "$STATE_DIR"
  else
    ADOPT_STATE_STAGE=$(mktemp -d "$(dirname "$STATE_DIR")/.state-adopt.XXXXXX")
    "$BIN" init --state-dir "$ADOPT_STATE_STAGE" --site-dir "$ADOPT_PULL/site"
    "$BIN" config set-public-base-url "$PUBLIC_URL" --state-dir "$ADOPT_STATE_STAGE"
    "$BIN" adopt --from-site "$ADOPT_PULL" --state-dir "$ADOPT_STATE_STAGE"
    "$BIN" verify --state-dir "$ADOPT_STATE_STAGE"
    adopt_marker "$ADOPT_STATE_STAGE"
    [ ! -d "$STATE_DIR" ] || rmdir "$STATE_DIR"
    mv "$ADOPT_STATE_STAGE" "$STATE_DIR"
    ADOPT_STATE_STAGE=""
  fi
  record_promoted_generation stuff-mycrates "$(adopted_generation "$ADOPT_PULL")"
  rm -rf "$ADOPT_PULL"
  ADOPT_PULL=""
}

adopt_mynpm() {
  echo "publish: no mynpm publication at $SITE_DIR; adopting the live publication" >&2
  cargo build -q -p mynpm --manifest-path "$STUFF_DIR/Cargo.toml"
  mkdir -p "$(dirname "$SITE_DIR")"
  ADOPT_STAGE=$(mktemp -d "$(dirname "$SITE_DIR")/mynpm-site-adopt.XXXXXX")
  python3 "$STUFF_DIR/deploy/r2-pull.py" stuff-mynpm "$ADOPT_STAGE/mirror"
  "$STUFF_DIR/target/debug/mynpm" adopt --site-dir "$ADOPT_STAGE"
  mkdir -p "$SITE_DIR"
  [ ! -d "$SITE_DIR/mirror" ] || rmdir "$SITE_DIR/mirror"
  mv "$ADOPT_STAGE/mirror" "$SITE_DIR/mirror"
  rmdir "$ADOPT_STAGE"
  ADOPT_STAGE=""
  record_promoted_generation stuff-mynpm "$(adopted_generation "$SITE_DIR/mirror")"
}

adopt_mypypi() {
  echo "publish: no mypypi publication at $SITE_DIR; adopting the live publication" >&2
  mkdir -p "$(dirname "$SITE_DIR")"
  ADOPT_STAGE=$(mktemp -d "$(dirname "$SITE_DIR")/mypypi-site-adopt.XXXXXX")
  python3 "$STUFF_DIR/deploy/r2-pull.py" stuff-mypypi "$ADOPT_STAGE"
  [ ! -d "$SITE_DIR" ] || rmdir "$SITE_DIR"
  mv "$ADOPT_STAGE" "$SITE_DIR"
  ADOPT_STAGE=""
  record_promoted_generation stuff-mypypi "$(adopted_generation "$SITE_DIR")"
}

oci_bucket_is_empty() {
  if [ -n "${CF_LOCAL_STATE:-}" ]; then
    cf r2 objects list --per-page 1 --bucket-name "$1" --local --persist-to "$CF_LOCAL_STATE"
  else
    cf r2 objects list --per-page 1 --bucket-name "$1"
  fi | python3 -c 'import json, sys; sys.exit(0 if json.load(sys.stdin) == [] else 1)'
}

adopt_oci() {
  if oci_bucket_is_empty "${BUCKET_META:-stuff-oci}"; then
    [ -z "$REPUBLISH" ] || fail "${BUCKET_META:-stuff-oci} is empty; nothing to republish"
    echo "publish: ${BUCKET_META:-stuff-oci} is empty; making the first publication" >&2
    return 0
  fi
  echo "publish: no OCI publication at $SITE_DIR; adopting the live publication" >&2
  cargo build -q -p myoci --manifest-path "$STUFF_DIR/Cargo.toml"
  BIN=$STUFF_DIR/target/debug/myoci
  META_BUCKET=${BUCKET_META:-stuff-oci}
  BLOBS_BUCKET=${BUCKET_BLOBS:-stuff-oci-blobs}
  mkdir -p "$(dirname "$SITE_DIR")" "$(dirname "$STATE_DIR")"
  ADOPT_STAGE=$(mktemp -d "$(dirname "$SITE_DIR")/oci-site-adopt.XXXXXX")
  python3 "$STUFF_DIR/deploy/r2-pull.py" "$META_BUCKET" "$ADOPT_STAGE/meta"
  GEN=$(basename "$(readlink "$ADOPT_STAGE/meta/current")")
  mkdir -p "$ADOPT_STAGE/meta/blobs/sha256"
  python3 - "$ADOPT_STAGE/meta/generations/$GEN/blobs.json" <<'PY' > "$ADOPT_STAGE/hexes"
import json
import sys
with open(sys.argv[1], encoding="utf-8") as f:
    document = json.load(f)
for digest in document["blobs"]:
    print(digest.split(":", 1)[1])
PY
  while read -r hex; do
    [ -n "$hex" ] || continue
    if [ -n "${CF_LOCAL_STATE:-}" ]; then
      cf r2 objects get "sha256/$hex" --bucket-name "$BLOBS_BUCKET" \
        --local --persist-to "$CF_LOCAL_STATE" > "$ADOPT_STAGE/meta/blobs/sha256/$hex"
    else
      cf r2 objects get "sha256/$hex" --bucket-name "$BLOBS_BUCKET" \
        > "$ADOPT_STAGE/meta/blobs/sha256/$hex"
    fi
  done < "$ADOPT_STAGE/hexes"
  if [ -d "$STATE_DIR" ] && [ -n "$(ls -A "$STATE_DIR" 2>/dev/null)" ]; then
    echo "publish: $STATE_DIR has no site but holds state; extending it in place" >&2
    "$BIN" adopt --state-dir "$STATE_DIR" --site-dir "$ADOPT_STAGE/meta"
    "$BIN" verify --state-dir "$STATE_DIR"
  else
    ADOPT_STATE_STAGE=$(mktemp -d "$(dirname "$STATE_DIR")/.state-adopt.XXXXXX")
    "$BIN" adopt --state-dir "$ADOPT_STATE_STAGE" --site-dir "$ADOPT_STAGE/meta"
    "$BIN" verify --state-dir "$ADOPT_STATE_STAGE"
    [ ! -d "$STATE_DIR" ] || rmdir "$STATE_DIR"
    mv "$ADOPT_STATE_STAGE" "$STATE_DIR"
    ADOPT_STATE_STAGE=""
  fi
  [ ! -d "$SITE_DIR" ] || rmdir "$SITE_DIR"
  mv "$ADOPT_STAGE/meta" "$SITE_DIR"
  rm -rf "$ADOPT_STAGE"
  ADOPT_STAGE=""
  record_promoted_generation stuff-oci "$GEN"
}

case $REGISTRY in
  mycrates)
    [ -n "$REPUBLISH" ] || [ -n "${CRATES:-}" ] || fail "CRATES is empty"
    STATE_DIR=${STATE_DIR:-$H/mycrates/state}
    SITE_DIR=${SITE_DIR:-$H/mycrates/site}
    PUBLIC_URL=${PUBLIC_URL:-https://crates.17166969.xyz}
    if [ ! -f "$STATE_DIR/.adopt-complete" ]; then
      adopt_locked adopt_mycrates
    else
      LIVE_GENERATION=$(live_generation stuff-mycrates)
      RECORDED_GENERATION=$(cat "$(promoted_generation_path stuff-mycrates)" 2>/dev/null || true)
      if [ -n "$LIVE_GENERATION" ] && [ "$LIVE_GENERATION" != "$RECORDED_GENERATION" ]; then
        echo "publish: live mycrates is on $LIVE_GENERATION, not ${RECORDED_GENERATION:-an unrecorded generation}" >&2
        adopt_locked adopt_mycrates
      fi
    fi
    export STATE_DIR SITE_DIR PUBLIC_URL
    "$STUFF_DIR/deploy/publish-mycrates.sh"
    ;;
  mynpm)
    [ -n "$REPUBLISH" ] || [ -n "${LOCKFILE:-}" ] || fail "LOCKFILE is empty"
    [ -n "$REPUBLISH" ] || [ -n "${PROJECT:-}" ] || fail "PROJECT is empty"
    SITE_DIR=${SITE_DIR:-$H/mynpm/site}
    if [ ! -e "$SITE_DIR/mirror/current" ]; then
      if [ -d "$SITE_DIR/mirror" ] && [ -n "$(ls -A "$SITE_DIR/mirror" 2>/dev/null)" ]; then
        fail "$SITE_DIR/mirror exists without current; refusing to overwrite it"
      fi
      adopt_locked adopt_mynpm
    fi
    export SITE_DIR
    "$STUFF_DIR/deploy/publish-mynpm.sh"
    ;;
  mypypi)
    [ -n "$REPUBLISH" ] || [ -n "${PACKAGES:-}" ] || fail "PACKAGES is empty"
    SITE_DIR=${SITE_DIR:-$H/mypypi/site}
    PUBLIC_URL=${PUBLIC_URL:-https://pypi.17166969.xyz}
    if [ ! -e "$SITE_DIR/current" ]; then
      if [ -d "$SITE_DIR" ] && [ -n "$(ls -A "$SITE_DIR" 2>/dev/null)" ]; then
        fail "$SITE_DIR exists without current; refusing to overwrite it"
      fi
      adopt_locked adopt_mypypi
    fi
    export SITE_DIR PUBLIC_URL
    "$STUFF_DIR/deploy/publish-mypypi.sh"
    ;;
  oci)
    [ -n "$REPUBLISH" ] || [ -n "${OCI_IMAGES:-}" ] || [ -n "${OCI_LAYOUT:-}" ] || fail "OCI_IMAGES or OCI_LAYOUT is empty"
    STATE_DIR=${STATE_DIR:-$H/oci/state}
    SITE_DIR=${SITE_DIR:-$H/oci/site}
    PUBLIC_URL=${PUBLIC_URL:-https://oci.17166969.xyz}
    if [ ! -e "$SITE_DIR/current" ]; then
      if [ -d "$SITE_DIR" ] && [ -n "$(ls -A "$SITE_DIR" 2>/dev/null)" ]; then
        fail "$SITE_DIR exists without current; refusing to overwrite it"
      fi
      adopt_locked adopt_oci
    fi
    export STATE_DIR SITE_DIR PUBLIC_URL
    "$STUFF_DIR/deploy/publish-myoci.sh"
    ;;
esac
