#!/bin/sh
# Publish one registry from the source repository that owns its packages.
# Usage: publish mycrates|mynpm|mypypi [--promote=cf|s3]
#   mycrates: CRATES="name-a name-b" publish mycrates
#   mynpm:    LOCKFILE=pnpm-lock.yaml PROJECT=project publish mynpm
#   mypypi:   PACKAGES="name==version" publish mypypi
#
# The wrapper checks cf auth, adopts the live publication until the local
# state carries a completion marker, and then runs the matching publish
# helper. Promotion defaults to cf, which is safe for a single publisher and
# needs no R2 S3 credentials.
# --promote=s3 keeps the conditional 412 guard for concurrent publishers.
set -eu
SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
STUFF_DIR=${STUFF_DIR:-$(cd "$SCRIPT_DIR/.." && pwd)}
export STUFF_DIR
H=${STUFF_STATE_HOME:-${XDG_STATE_HOME:-$HOME/.local/state}/stuff}
ADOPT_PULL=""
ADOPT_STATE_STAGE=""
ADOPT_STAGE=""

usage() {
  cat >&2 <<'EOF'
usage: publish mycrates|mynpm|mypypi [--promote=cf|s3]
  mycrates: CRATES="name-a name-b" publish mycrates
  mynpm:    LOCKFILE=pnpm-lock.yaml PROJECT=project publish mynpm
  mypypi:   PACKAGES="name==version" publish mypypi
EOF
}

fail() {
  echo "publish: $1" >&2
  exit 2
}

cleanup() {
  status=$?
  trap - EXIT
  [ -z "$ADOPT_PULL" ] || rm -rf "$ADOPT_PULL" || true
  [ -z "$ADOPT_STATE_STAGE" ] || rm -rf "$ADOPT_STATE_STAGE" || true
  if [ -n "$ADOPT_STAGE" ]; then
    if [ "$status" -eq 0 ]; then
      rm -rf "$ADOPT_STAGE" || true
    else
      echo "publish: adoption failed; staging is at $ADOPT_STAGE" >&2
      echo "publish: inspect it, then remove it with: rm -rf '$ADOPT_STAGE'" >&2
    fi
  fi
  exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

REGISTRY=${1:-}
case $REGISTRY in
  -h | --help)
    usage
    exit 0
    ;;
  mycrates | mynpm | mypypi) ;;
  *) usage; exit 2 ;;
esac
shift
PROMOTE=cf
while [ $# -gt 0 ]; do
  case $1 in
    --promote=cf | --promote=s3)
      PROMOTE=${1#--promote=}
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      usage
      exit 2
      ;;
  esac
done

command -v cf >/dev/null 2>&1 || fail "the cf CLI is not on PATH"
cf auth whoami 2>/dev/null | grep -q '"authenticated"[[:space:]]*:[[:space:]]*true' ||
  fail "cf is not authenticated; run cf auth login"

case $PROMOTE in
  cf)
    export R2_PROMOTE_UNCONDITIONAL=1
    ;;
  s3)
    unset R2_PROMOTE_UNCONDITIONAL
    for var in R2_S3_ENDPOINT R2_S3_ACCESS_KEY_ID R2_S3_SECRET_ACCESS_KEY; do
      eval "value=\${$var:-}"
      [ -n "$value" ] || fail "$var is not set; --promote=s3 needs the R2 S3 API"
    done
    ;;
esac

adopt_marker() {
  printf 'adopted %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$1/.adopt-complete"
}

adopt_mycrates() {
  echo "publish: adopting the live mycrates publication into $STATE_DIR" >&2
  cargo build -q -p mycrates --manifest-path "$STUFF_DIR/Cargo.toml"
  BIN=$STUFF_DIR/target/debug/mycrates
  mkdir -p "$H" "$(dirname "$STATE_DIR")"
  ADOPT_PULL=$(mktemp -d "$H/mycrates-adopt.XXXXXX")
  python3 "$STUFF_DIR/deploy/r2-pull.py" stuff-mycrates "$ADOPT_PULL"
  if [ -d "$STATE_DIR" ] && [ -n "$(ls -A "$STATE_DIR" 2>/dev/null)" ]; then
    echo "publish: $STATE_DIR has no adoption marker; extending it in place" >&2
    "$BIN" init --state-dir "$STATE_DIR" --site-dir "$ADOPT_PULL/site"
    "$BIN" config set-public-base-url "$PUBLIC_URL" --state-dir "$STATE_DIR"
    "$BIN" adopt --from-site "$ADOPT_PULL" --state-dir "$STATE_DIR"
    "$BIN" verify --state-dir "$STATE_DIR"
    adopt_marker "$STATE_DIR"
  else
    ADOPT_STATE_STAGE=$(mktemp -d "$(dirname "$STATE_DIR")/.state-adopt.XXXXXX")
    "$BIN" init --state-dir "$ADOPT_STATE_STAGE" --site-dir "$ADOPT_PULL/site"
    "$BIN" config set-public-base-url "$PUBLIC_URL" --state-dir "$ADOPT_STATE_STAGE"
    "$BIN" adopt --from-site "$ADOPT_PULL" --state-dir "$ADOPT_STATE_STAGE"
    "$BIN" verify --state-dir "$ADOPT_STATE_STAGE"
    adopt_marker "$ADOPT_STATE_STAGE"
    [ ! -d "$STATE_DIR" ] || rmdir "$STATE_DIR"
    mv "$ADOPT_STATE_STAGE" "$STATE_DIR"
    ADOPT_STATE_STAGE=""
  fi
  rm -rf "$ADOPT_PULL"
  ADOPT_PULL=""
}

adopt_mynpm() {
  echo "publish: no mynpm publication at $SITE_DIR; adopting the live publication" >&2
  cargo build -q -p mynpm --manifest-path "$STUFF_DIR/Cargo.toml"
  mkdir -p "$(dirname "$SITE_DIR")"
  ADOPT_STAGE=$(mktemp -d "$(dirname "$SITE_DIR")/mynpm-site-adopt.XXXXXX")
  python3 "$STUFF_DIR/deploy/r2-pull.py" stuff-mynpm "$ADOPT_STAGE/mirror"
  "$STUFF_DIR/target/debug/mynpm" adopt --site-dir "$ADOPT_STAGE"
  mkdir -p "$SITE_DIR"
  [ ! -d "$SITE_DIR/mirror" ] || rmdir "$SITE_DIR/mirror"
  mv "$ADOPT_STAGE/mirror" "$SITE_DIR/mirror"
  rmdir "$ADOPT_STAGE"
  ADOPT_STAGE=""
}

adopt_mypypi() {
  echo "publish: no mypypi publication at $SITE_DIR; adopting the live publication" >&2
  mkdir -p "$(dirname "$SITE_DIR")"
  ADOPT_STAGE=$(mktemp -d "$(dirname "$SITE_DIR")/mypypi-site-adopt.XXXXXX")
  python3 "$STUFF_DIR/deploy/r2-pull.py" stuff-mypypi "$ADOPT_STAGE"
  [ ! -d "$SITE_DIR" ] || rmdir "$SITE_DIR"
  mv "$ADOPT_STAGE" "$SITE_DIR"
  ADOPT_STAGE=""
}

case $REGISTRY in
  mycrates)
    [ -n "${CRATES:-}" ] || fail "CRATES is empty"
    STATE_DIR=${STATE_DIR:-$H/mycrates/state}
    SITE_DIR=${SITE_DIR:-$H/mycrates/site}
    PUBLIC_URL=${PUBLIC_URL:-https://crates.17166969.xyz}
    if [ ! -f "$STATE_DIR/.adopt-complete" ]; then
      adopt_mycrates
    fi
    export STATE_DIR SITE_DIR PUBLIC_URL
    "$STUFF_DIR/deploy/publish-mycrates.sh"
    ;;
  mynpm)
    [ -n "${LOCKFILE:-}" ] || fail "LOCKFILE is empty"
    [ -n "${PROJECT:-}" ] || fail "PROJECT is empty"
    SITE_DIR=${SITE_DIR:-$H/mynpm/site}
    if [ ! -e "$SITE_DIR/mirror/current" ]; then
      if [ -d "$SITE_DIR/mirror" ] && [ -n "$(ls -A "$SITE_DIR/mirror" 2>/dev/null)" ]; then
        fail "$SITE_DIR/mirror exists without current; refusing to overwrite it"
      fi
      adopt_mynpm
    fi
    export SITE_DIR
    "$STUFF_DIR/deploy/publish-mynpm.sh"
    ;;
  mypypi)
    [ -n "${PACKAGES:-}" ] || fail "PACKAGES is empty"
    SITE_DIR=${SITE_DIR:-$H/mypypi/site}
    PUBLIC_URL=${PUBLIC_URL:-https://pypi.17166969.xyz}
    if [ ! -e "$SITE_DIR/current" ]; then
      if [ -d "$SITE_DIR" ] && [ -n "$(ls -A "$SITE_DIR" 2>/dev/null)" ]; then
        fail "$SITE_DIR exists without current; refusing to overwrite it"
      fi
      adopt_mypypi
    fi
    export SITE_DIR PUBLIC_URL
    "$STUFF_DIR/deploy/publish-mypypi.sh"
    ;;
esac
