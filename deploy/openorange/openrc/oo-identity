#!/sbin/openrc-run
# OpenOrange tailnet identity sidecar
# Installed by bin/install. Foreground `docker run --rm` under supervise-daemon.

. /opt/openorange/openrc/oo-common.sh

description="OpenOrange tailnet identity sidecar"
supervisor=supervise-daemon
command=/usr/bin/docker
respawn_delay=3
respawn_max=0
respawn_period=60
output_log="$OO_LOGDIR/identity.log"
error_log="$OO_LOGDIR/identity.log"
retry="TERM/10/KILL/5"

depend() {
	need docker net
	after tailscale
}

start_pre() {
	"$OO_BIN" prepare identity || return 1
	oo_remove_container oo-identity
	command_args="$("$OO_BIN" run-args identity)" || return 1
}

start_post() {
	oo_wait identity 30 || { eerror "oo-identity did not become ready"; oo_fail_stop oo-identity; return 1; }
}

stop_post() {
	oo_remove_container oo-identity
}
