#!/usr/bin/env python3
"""Disk accounting per component and per app. Run as root.

    disk-usage [--json]

Engine and store have separate volumes/directories; each app's bucket set is
the sum of its bucket directories in the store (versions included).
"""
import json
import os
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(os.path.realpath(__file__)).parent.parent / "lib"))
import oolib  # noqa: E402


def du(path: Path) -> int:
    if not path.exists():
        return 0
    r = subprocess.run(["du", "-sk", str(path)], capture_output=True, text=True)
    return int(r.stdout.split()[0]) * 1024 if r.returncode == 0 and r.stdout else 0


def human(n: int) -> str:
    for u in ("B", "KiB", "MiB", "GiB", "TiB"):
        if n < 1024 or u == "TiB":
            return f"{n:.0f} {u}" if u == "B" else f"{n / 1:.1f} {u}"
        n /= 1024


def main():
    cfg = oolib.load()
    s = cfg.state
    rows = [
        ("engine/log (unflushed writes + identity; never delete)", du(s / "engine" / "log")),
        ("engine/objects (durable tier; separate from app buckets)", du(s / "engine" / "objects")),
    ]
    for a in cfg.orange_apps():
        size = sum(du(s / "store" / "data" / b) + du(s / "store" / "versions" / b) for b in a.buckets)
        rows.append((f"app {a.name}: buckets {','.join(a.buckets) or '-'}", size))
    known = {b for a in cfg.apps.values() if a.kind == "orange" for b in a.buckets}
    data = s / "store" / "data"
    orphans = sorted(p.name for p in data.iterdir() if p.is_dir() and p.name not in known and not p.name.startswith(".")) if data.exists() else []
    rows += [
        ("store/data total (all buckets + lock dir)", du(data)),
        ("store/versions total", du(s / "store" / "versions")),
        ("store/iam", du(s / "store" / "iam")),
        ("caddy (certs, internal CA)", du(s / "caddy")),
        ("backups", du(s / "backups")),
        ("restore rehearsals", du(s / "restore")),
        ("logs", du(cfg.logs)),
    ]
    st = os.statvfs(s)
    free, total = st.f_bavail * st.f_frsize, st.f_blocks * st.f_frsize
    r = subprocess.run(["docker", "system", "df", "--format", "{{.Type}}: {{.Size}} ({{.Reclaimable}} reclaimable)"], capture_output=True, text=True)
    if "--json" in sys.argv:
        print(json.dumps({"rows": [{"what": w, "bytes": b} for w, b in rows], "unknown_bucket_dirs": orphans,
                          "fs_free_bytes": free, "fs_total_bytes": total, "docker": r.stdout.splitlines()}, indent=2))
        return
    for w, b in rows:
        print(f"{human(b):>10}  {w}")
    if orphans:
        print(f"{'':>10}  WARNING store bucket dirs not in apps.toml: {', '.join(orphans)}")
    print(f"{human(free):>10}  free of {human(total)} on the state filesystem")
    for ln in r.stdout.splitlines():
        print(f"{'':>10}  docker {ln}")


if __name__ == "__main__":
    main()
