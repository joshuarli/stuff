#!/usr/bin/env python3
"""OpenOrange host stack control: validation, rendering, provisioning.

    oo validate                 check apps.toml (+ /etc/openorange/overlay.toml)
    oo images                   print pinned image references
    oo apps-list [--all]        enabled Orange apps that have an image (--all: even without)
    oo run-args SERVICE [APP]   docker run argument vector (used by OpenRC units)
    oo secrets                  create missing secrets/env files (root-only, never printed)
    oo prepare SERVICE [APP]    create directories and ownership a unit needs
    oo render [--stdout [--tls internal|acme]]   write engine config, Caddyfile, ingress env, conf.d
    oo network                  ensure the private docker network
    oo provision [APP...]       store users/buckets, Rivet namespaces/pools
    oo set-image APP IMAGE      point an app at a (locally built) image
    oo remove APP [--purge-store]  stop and unregister an app (optionally delete its buckets and S3 key)
    oo reload-ingress           validate and gracefully reload Caddy
    oo wait SERVICE [APP] [SECS]  block until a service answers

Must run as root for anything that touches /etc/openorange.
"""
from __future__ import annotations

import json
import os
import shlex
import socket
import sys
import time
import urllib.error
import urllib.request
import xml.etree.ElementTree as ET
from pathlib import Path

sys.path.insert(0, str(Path(os.path.realpath(__file__)).parent.parent / "lib"))
import oolib  # noqa: E402
from oo_s3 import S3  # noqa: E402
from oolib import UID, ConfigError  # noqa: E402

SERVICES = ("store", "engine", "identity", "ingress", "app")


def die(msg: str, code: int = 1):
    print(f"oo: {msg}", file=sys.stderr)
    sys.exit(code)


def chown_dir(path: Path, mode: int, uid: int | None = int(UID)) -> None:
    path.mkdir(parents=True, exist_ok=True)
    os.chmod(path, mode)
    if uid is not None:
        os.chown(path, uid, uid)


# ------------------------------------------------------------------ secrets
def cmd_secrets(cfg) -> None:
    etc = cfg.etc
    etc.mkdir(parents=True, exist_ok=True)
    os.chmod(etc, 0o700)
    (etc / "apps").mkdir(exist_ok=True)
    os.chmod(etc / "apps", 0o700)

    store = oolib.read_env(cfg.store_env)
    store.setdefault("ROOT_ACCESS_KEY", "OOROOT" + oolib.token(8).upper())
    store.setdefault("ROOT_SECRET_KEY", oolib.token(20))
    oolib.write_env(cfg.store_env, store, "versitygw root credentials (root-only)")

    engine = oolib.read_env(cfg.engine_env)
    engine.setdefault("RIVET__AUTH__ADMIN_TOKEN", oolib.token(32))
    oolib.write_env(cfg.engine_env, engine, "Rivet Engine admin token (root-only)")

    for app in cfg.apps.values():
        path = cfg.app_env(app)
        cur = oolib.read_env(path)
        env: dict[str, str] = {"GATEWAY_SECRET": cur.get("GATEWAY_SECRET") or oolib.token(32)}
        if app.kind == "orange":
            env.update(
                RIVET_ENDPOINT=cfg.engine_url,
                RIVET_NAMESPACE=app.namespace,
                RIVET_TOKEN=engine["RIVET__AUTH__ADMIN_TOKEN"],
                S3_ENDPOINT=cfg.store_url,
                S3_REGION=cfg.store["region"],
                S3_ACCESS_KEY_ID=cur.get("S3_ACCESS_KEY_ID") or "OOAPP" + oolib.token(8).upper(),
                S3_SECRET_ACCESS_KEY=cur.get("S3_SECRET_ACCESS_KEY") or oolib.token(20),
                S3_BUCKETS=",".join(app.buckets),
                # open-orange builds Worker secret bindings from the environment variables named here.
                ORANGE_WORKER_SECRETS=",".join(["GATEWAY_SECRET", *app.secrets]),
            )
            # Orange maps each R2 binding onto an S3 endpoint through these
            # variables (runtime-node r2/s3-backend); the bucket name is the
            # R2 `bucket_name` of the binding.
            for b in app.buckets:
                pre = "ORANGE_R2_" + "".join(c if c.isalnum() else "_" for c in b.upper()) + "_S3_"
                env.update({pre + "ENDPOINT": cfg.store_url, pre + "REGION": cfg.store["region"], pre + "BUCKET": b,
                            pre + "ACCESS_KEY_ID": env["S3_ACCESS_KEY_ID"], pre + "SECRET_ACCESS_KEY": env["S3_SECRET_ACCESS_KEY"]})
        oolib.write_env(path, env, f"{app.name}: runtime secrets and endpoints (root-only; derived values rewritten by `oo secrets`)")
    print("secrets: ok (values are never printed)")


# ------------------------------------------------------------------ render
CADDY_STRIP = ["Tailscale-*", "Stats-Gateway-Secret", "Stats-Tailnet-Identity", "X-OO-Peer", "X-OO-Ingress", "X-Forwarded-*", "Forwarded", "X-Real-Ip"]


def render_caddyfile(cfg) -> str:
    ing = cfg.ingress
    lines = [
        "# Generated by `oo render` from apps.toml. Do not edit.",
        "{",
        "\tadmin unix//run/caddy/admin.sock",
        "\tauto_https disable_redirects",
        "\tgrace_period 15s",
        "\tskip_install_trust",
        "\tlog {",
        "\t\toutput stdout",
        "\t\tformat console",
        "\t}",
        "}",
        "",
    ]
    tls = "tls internal" if ing["tls"] == "internal" else "tls {\n\t\tdns cloudflare {env.CF_API_TOKEN}\n\t}"
    for app in cfg.enabled_apps():
        addrs = ", ".join(app.hostnames)
        lines += [f"# {app.display} ({app.kind})", f"{addrs} {{", f"\tbind {ing['bind']}", f"\t{tls}"]
        lines += ["\tlog {", "\t\toutput stdout", "\t\tformat filter {", "\t\t\twrap console",
                  "\t\t\tfields {", "\t\t\t\trequest>headers delete", "\t\t\t\tresp_headers delete", "\t\t\t}", "\t\t}", "\t}"]
        lines += ["\troute {"]
        lines += [f"\t\trequest_header -{h}" for h in CADDY_STRIP]
        lines += ["\t\trequest_header X-OO-Ingress tailnet"]
        lines += [
            "\t\tforward_auth unix//run/identity/identity.sock {",
            "\t\t\turi /auth",
            "\t\t\theader_up X-OO-Peer {http.request.remote}",
            "\t\t\tcopy_headers Stats-Tailnet-Identity",
            "\t\t}",
        ]
        if app.kind == "orange" and not cfg.app_image_file(app).exists():
            lines += ['\t\trespond "app not deployed" 503']
        else:
            upstream = app.upstream if app.kind == "native" else f"{app.ip}:{app.port}"
            lines += [
                f"\t\treverse_proxy {upstream} {{",
                f"\t\t\theader_up Stats-Gateway-Secret {{env.GW_SECRET_{app.env_key}}}",
                "\t\t}",
            ]
        lines += ["\t}", "}", ""]
    pub = cfg.public
    pub_apps = [a for a in cfg.enabled_apps() if a.public_hostnames]
    if pub and pub_apps:
        port = pub["port"]
        lines += [
            "# Public listener: plain HTTP on loopback only, reached by the outbound cloudflared tunnel.",
            "# No identity sidecar and no gateway secret: the app sees `X-OO-Ingress: public` and nothing else.",
        ]
        for app in pub_apps:
            addrs = ", ".join(f"http://{h}:{port}" for h in app.public_hostnames)
            lines += [f"# {app.display} (public)", f"{addrs} {{", f"\tbind {pub['bind']}", "\troute {"]
            lines += [f"\t\trequest_header -{h}" for h in CADDY_STRIP]
            lines += ["\t\trequest_header X-OO-Ingress public"]
            for i, path in enumerate(app.public_deny_paths):
                lines += [f"\t\t@deny{i} path {path} {path}/*",
                          f"\t\trespond @deny{i} 404",
                          # Tolerate dot segments, repeated slashes and `;params` the app might normalise away.
                          f"\t\t@denyre{i} path_regexp (?i)^/+(?:\\.{{1,2}}/+)*{path.lstrip('/')}(?:[/;]|$)",
                          f"\t\trespond @denyre{i} 404"]
            if app.kind == "orange" and not cfg.app_image_file(app).exists():
                lines += ['\t\trespond "app not deployed" 503']
            else:
                lines += [f"\t\treverse_proxy {app.ip}:{app.port}"]
            lines += ["\t}", "}", ""]
        lines += [f"# Any other Host on the public listener", f"http://:{port} {{", f"\tbind {pub['bind']}", '\trespond "not found" 404', "}", ""]
    return "\n".join(lines)


def cmd_render(cfg, stdout: bool = False) -> None:
    if stdout:
        print(render_caddyfile(cfg), end="")
        return
    # engine config
    ecfg = {
        "storage": {"log_directory": "/var/lib/rivet/log", "auto_provision_partitions": 1, "balancing": {"enabled": False}},
        "object_storage": {"primary": {"file_system": {"path": "/var/lib/rivet/objects"}}},
        "telemetry": {"enabled": False},
    }
    d = cfg.etc / "engine"
    d.mkdir(parents=True, exist_ok=True)
    (d / "config.json").write_text(json.dumps(ecfg, indent=2) + "\n")
    os.chmod(d / "config.json", 0o644)
    os.chmod(d, 0o755)
    # ingress
    d = cfg.etc / "ingress"
    d.mkdir(parents=True, exist_ok=True)
    os.chmod(d, 0o755)
    (d / "Caddyfile").write_text(render_caddyfile(cfg))
    os.chmod(d / "Caddyfile", 0o644)
    env = {}
    for app in cfg.enabled_apps():
        sec = oolib.read_env(cfg.app_env(app)).get("GATEWAY_SECRET")
        if not sec:
            die(f"missing gateway secret for {app.name}; run `oo secrets`")
        env[f"GW_SECRET_{app.env_key}"] = sec
    oolib.write_env(cfg.etc / "ingress.env", env, "per-app gateway secrets for Caddy (derived; root-only)")
    # OpenRC ordering: ingress starts after, and therefore stops before, every app.
    conf = Path("/etc/conf.d/oo-ingress")
    after = " ".join(a.service for a in cfg.orange_apps())
    conf.write_text(f'# Generated by `oo render`.\nrc_after="{after}"\n')
    print(f"render: ok (tls={cfg.ingress['tls']}, {len(cfg.enabled_apps())} apps, {sum(len(a.hostnames) for a in cfg.enabled_apps())} hostnames)")


# ------------------------------------------------------------------ prepare
def cmd_prepare(cfg, service: str, app: str | None) -> None:
    u = int(UID)
    if service == "store":
        for d in ("data", "versions", "iam"):
            chown_dir(cfg.state / "store" / d, 0o700)
        chown_dir(cfg.run / "store-admin", 0o700)
        for f in (cfg.store_env,):
            if not f.exists():
                die(f"{f} missing: run `oo secrets`")
        sock = cfg.run / "store-admin" / "admin.sock"
        if sock.exists():
            sock.unlink()
    elif service == "engine":
        for d in ("log", "objects"):
            chown_dir(cfg.state / "engine" / d, 0o700)
        if not cfg.engine_env.exists() or not (cfg.etc / "engine" / "config.json").exists():
            die("engine env/config missing: run `oo secrets && oo render`")
    elif service == "identity":
        chown_dir(cfg.run / "identity", 0o700)
        sock = cfg.run / "identity" / "identity.sock"
        if sock.exists():
            sock.unlink()
    elif service == "ingress":
        for d in ("data", "config"):
            chown_dir(cfg.state / "caddy" / d, 0o700)
        chown_dir(cfg.run / "caddy", 0o700)
        cmd_render(cfg)
    elif service == "app":
        if not app or app not in cfg.apps or cfg.apps[app].kind != "orange":
            die(f"unknown orange app {app!r}")
        if not cfg.app_env(cfg.apps[app]).exists():
            die(f"{cfg.app_env(cfg.apps[app])} missing: run `oo secrets`")
    else:
        die(f"unknown service {service}")
    cfg.logs.mkdir(parents=True, exist_ok=True)
    os.chmod(cfg.logs, 0o750)
    cfg.run.mkdir(parents=True, exist_ok=True)
    os.chmod(cfg.run, 0o755)
    _ = u


# ------------------------------------------------------------------ network
def cmd_network(cfg) -> None:
    n = cfg.network
    r = oolib.docker("network", "inspect", n["name"], check=False)
    if r.returncode == 0:
        info = json.loads(r.stdout)[0]
        subs = [c["Subnet"] for c in info["IPAM"]["Config"]]
        if n["subnet"] not in subs or bool(info["Internal"]) != n["internal"]:
            die(f"network {n['name']} exists with subnet {subs}, internal={info['Internal']}: refusing to change")
        print(f"network: {n['name']} ok")
        return
    args = ["network", "create", "--driver", "bridge", "--subnet", n["subnet"],
            "--opt", f"com.docker.network.bridge.name={n['bridge']}"]
    if n["internal"]:
        args.append("--internal")
    oolib.docker(*args, n["name"])
    print(f"network: created {n['name']} {n['subnet']} internal={n['internal']}")


# ------------------------------------------------------------------ provision
def store_admin(cfg) -> S3:
    env = oolib.read_env(cfg.store_env)
    sock = cfg.run / "store-admin" / "admin.sock"
    if not sock.exists():
        die("store admin socket missing: is oo-store running?")
    return S3(f"unix:{sock}", cfg.store["region"], env["ROOT_ACCESS_KEY"], env["ROOT_SECRET_KEY"], timeout=15)


def store_s3(cfg) -> S3:
    env = oolib.read_env(cfg.store_env)
    return S3(cfg.store_url, cfg.store["region"], env["ROOT_ACCESS_KEY"], env["ROOT_SECRET_KEY"], timeout=15)


def provision_store(cfg, apps) -> None:
    adm = store_admin(cfg)
    st, _, body = adm.request("PATCH", "/list-users")
    if st != 200:
        die(f"store list-users -> {st}")
    existing = {e.text for e in ET.fromstring(body).iter("Access")}
    st, _, body = store_s3(cfg).request("GET", "/")
    if st != 200:
        die(f"store list-buckets -> {st}")
    buckets = {e.text for e in ET.fromstring(body).iter() if e.tag.endswith("Name") and e.text}
    for app in apps:
        env = oolib.read_env(cfg.app_env(app))
        ak, sk = env["S3_ACCESS_KEY_ID"], env["S3_SECRET_ACCESS_KEY"]
        if ak not in existing:
            xml = (f"<Account><Access>{ak}</Access><Secret>{sk}</Secret><Role>user</Role><UserID>0</UserID>"
                   "<GroupID>0</GroupID><ProjectID>0</ProjectID><RoleArn></RoleArn></Account>").encode()
            st, _, b = adm.request("PATCH", "/create-user", body=xml)
            if st not in (200, 201):
                die(f"store create-user for {app.name} -> {st}")
            print(f"store: created user for {app.name}")
        for b in app.buckets:
            if b not in buckets:
                st, _, body = adm.request("PATCH", f"/{b}/create", headers={"x-vgw-owner": ak})
                if st not in (200, 201):
                    die(f"store create bucket {b} -> {st}")
                print(f"store: created bucket {b} (owner {app.s3_user})")
            else:
                st, _, _ = adm.request("PATCH", "/change-bucket-owner/", query={"bucket": b, "owner": ak})
                if st != 200:
                    die(f"store change-bucket-owner {b} -> {st}")


def engine_call(cfg, method: str, path: str, body: dict | None = None):
    tok = oolib.read_env(cfg.engine_env)["RIVET__AUTH__ADMIN_TOKEN"]
    req = urllib.request.Request(cfg.engine_url + path, method=method, data=json.dumps(body).encode() if body is not None else None,
                                 headers={"Authorization": f"Bearer {tok}", "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=15) as r:
            return r.status, json.loads(r.read() or b"null")
    except urllib.error.HTTPError as e:
        try:
            return e.code, json.loads(e.read())
        except ValueError:
            return e.code, None


def provision_engine(cfg, apps) -> None:
    st, doc = engine_call(cfg, "GET", "/namespaces")
    if st != 200:
        die(f"engine list namespaces -> {st}")
    have = {n["name"] for n in doc["namespaces"]}
    for app in apps:
        if app.namespace not in have:
            st, doc = engine_call(cfg, "POST", "/namespaces", {"name": app.namespace})
            if st != 200:
                die(f"engine create namespace {app.namespace} -> {st} {doc}")
            print(f"engine: created namespace {app.namespace}")
        for pool in oolib.ORANGE_POOLS:
            st, doc = engine_call(cfg, "PUT", f"/pools/{pool}?namespace={app.namespace}", {})
            if st != 200:
                die(f"engine create pool {app.namespace}/{pool} -> {st} {doc}")


def cmd_provision(cfg, names: list[str]) -> None:
    apps = [cfg.apps[n] for n in names] if names else cfg.orange_apps()
    for a in apps:
        if a.kind != "orange":
            die(f"{a.name} is a native app; nothing to provision")
    cmd_secrets(cfg)
    cmd_network(cfg)
    provision_store(cfg, apps)
    provision_engine(cfg, apps)
    print("provision: ok for " + ", ".join(a.name for a in apps))


def cmd_set_image(cfg, app: str, image: str) -> None:
    a = cfg.apps.get(app)
    if not a or a.kind != "orange":
        die(f"unknown orange app {app}")
    f = cfg.app_image_file(a)
    deployment = oolib.set_app_deployment(f, image.strip())
    print(f"{app}: image -> {deployment.image}, node version {deployment.version} (previous kept in {f.with_suffix('.image.prev').name})")


# ------------------------------------------------------------------ remove
def cmd_remove(cfg, name: str, purge_store: bool) -> None:
    """Stop and unregister one app. Never touches another app's container.

    The Rivet namespace is left in place: Engine 3.1.x has no namespace delete
    endpoint, so a removed app's Durable Object state stays in the Engine
    volumes until the Engine storage itself is reset.
    """
    import subprocess

    app = cfg.apps.get(name)
    if not app or app.kind != "orange":
        die(f"unknown orange app {name}")
    svc = app.service
    subprocess.run(["rc-service", svc, "stop"], capture_output=True)
    subprocess.run(["rc-update", "del", svc, "default"], capture_output=True)
    link = Path("/etc/init.d") / svc
    if link.is_symlink():
        link.unlink()
    env = oolib.read_env(cfg.app_env(app))
    if purge_store and env.get("S3_ACCESS_KEY_ID"):
        s3 = store_s3(cfg)
        for b in app.buckets:
            tok = None
            while True:
                q = {"list-type": "2", **({"continuation-token": tok} if tok else {})}
                st, _, body = s3.request("GET", f"/{b}", query=q)
                if st != 200:
                    break
                root = ET.fromstring(body)
                for c in root.iter():
                    if c.tag.endswith("}Key") or c.tag == "Key":
                        s3.request("DELETE", f"/{b}/{c.text}")
                trunc = [c.text for c in root.iter() if c.tag.endswith("IsTruncated")]
                nxt = [c.text for c in root.iter() if c.tag.endswith("NextContinuationToken")]
                if trunc and trunc[0] == "true" and nxt:
                    tok = nxt[0]
                else:
                    break
            st, _, _ = s3.request("DELETE", f"/{b}")
            print(f"store: bucket {b} deleted (http {st})")
        st, _, _ = store_admin(cfg).request("PATCH", "/delete-user", query={"access": env["S3_ACCESS_KEY_ID"]})
        print(f"store: user for {name} deleted (http {st})")
    for f in (cfg.app_env(app), cfg.app_image_file(app), cfg.app_extra_env(app), cfg.app_image_file(app).with_suffix(".image.prev")):
        f.unlink(missing_ok=True)
    print(f"{name}: stopped and unregistered. Remove its [apps.{name}] table (or the overlay), then `oo reload-ingress`.")
    print(f"note: Rivet namespace `{app.namespace}` remains (no delete endpoint in Engine 3.1.x)")


# ------------------------------------------------------------------ ingress
def cmd_reload_ingress(cfg) -> None:
    cmd_render(cfg)
    base = ["exec", "oo-ingress", "caddy"]
    v = oolib.docker(*base, "validate", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile", check=False)
    if v.returncode != 0:
        die(f"Caddyfile invalid, not reloading:\n{v.stderr[-800:]}")
    r = oolib.docker(*base, "reload", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile",
                     "--address", "unix//run/caddy/admin.sock", check=False)
    if r.returncode != 0:
        die(f"reload failed:\n{r.stderr[-800:]}")
    print("ingress: reloaded")


# ------------------------------------------------------------------ wait
def http_ok(url: str, headers=None, timeout=3, ok=lambda s: 200 <= s < 300) -> bool:
    req = urllib.request.Request(url, headers=headers or {})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return ok(r.status)
    except urllib.error.HTTPError as e:
        return ok(e.code)
    except (OSError, ValueError):
        return False


def ready(cfg, service: str, app: str | None) -> bool:
    if service == "store":
        return http_ok(cfg.store_url + "/health")
    if service == "engine":
        return http_ok(cfg.engine_url + "/health")
    if service == "identity":
        s = socket.socket(socket.AF_UNIX)
        s.settimeout(2)
        try:
            s.connect(str(cfg.run / "identity" / "identity.sock"))
            return True
        except OSError:
            return False
        finally:
            s.close()
    if service == "ingress":
        try:
            with socket.create_connection((cfg.ingress["bind"], 443), timeout=2):
                return True
        except OSError:
            return False
    if service == "app":
        a = cfg.apps[app]
        return http_ok(f"http://{a.ip}:{a.port}{a.health_path}", ok=lambda s: s < 500)
    return False


def cmd_wait(cfg, service: str, app: str | None, secs: float) -> None:
    deadline = time.time() + secs
    while time.time() < deadline:
        if ready(cfg, service, app):
            return
        time.sleep(1)
    die(f"{service}{'.' + app if app else ''} not ready after {secs:.0f}s", 2)


# ------------------------------------------------------------------ main
def main(argv: list[str]) -> None:
    if len(argv) < 2 or argv[1] in ("-h", "--help", "help"):
        print(__doc__)
        return
    cmd, rest = argv[1], argv[2:]
    try:
        cfg = oolib.load()
        if cmd == "validate":
            print(f"apps.toml ok: {len(cfg.apps)} apps ({', '.join(a.name + ('' if a.enabled else '[disabled]') for a in cfg.apps.values())}), tls={cfg.ingress['tls']}")
        elif cmd == "images":
            for k in oolib.lock()["images"]:
                print(f"{k:16} {oolib.image_ref(k)}")
            for k in oolib.lock()["local_builds"]:
                print(f"{k:16} {oolib.local_tag(k)} (built locally)")
        elif cmd == "run-args":
            service = rest[0]
            print(shlex.join(oolib.run_args(cfg, service, rest[1] if len(rest) > 1 else None)))
        elif cmd == "apps-list":
            allapps = rest[:1] == ["--all"]
            print("\n".join(a.name for a in cfg.orange_apps() if allapps or cfg.app_image_file(a).exists()))
        elif cmd == "secrets":
            cmd_secrets(cfg)
        elif cmd == "prepare":
            cmd_prepare(cfg, rest[0], rest[1] if len(rest) > 1 else None)
        elif cmd == "render":
            if "--tls" in rest:  # preview only: `oo render --tls acme --stdout`
                cfg.ingress["tls"] = rest[rest.index("--tls") + 1]
                if "--stdout" not in rest:
                    die("--tls overrides apps.toml only for a --stdout preview; edit [ingress].tls to change it")
            cmd_render(cfg, stdout="--stdout" in rest)
        elif cmd == "network":
            cmd_network(cfg)
        elif cmd == "provision":
            cmd_provision(cfg, rest)
        elif cmd == "set-image":
            cmd_set_image(cfg, rest[0], rest[1])
        elif cmd == "reload-ingress":
            cmd_reload_ingress(cfg)
        elif cmd == "remove":
            cmd_remove(cfg, rest[0], "--purge-store" in rest)
        elif cmd == "wait":
            svc = rest[0]
            app = rest[1] if svc == "app" else None
            secs = float(rest[2] if svc == "app" and len(rest) > 2 else rest[1] if svc != "app" and len(rest) > 1 else 60)
            cmd_wait(cfg, svc, app, secs)
        else:
            die(f"unknown command {cmd}")
    except ConfigError as e:
        die(str(e))
    except (IndexError, KeyError) as e:
        die(f"bad usage or missing config key: {e!r}")


if __name__ == "__main__":
    main(sys.argv)
