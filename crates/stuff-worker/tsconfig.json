{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": ".",
    "outDir": ".cloudflare/output/v0/workers/default/bundle",
    "sourceMap": true,
    "strict": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["src/**/*.ts", "build/wasm/*.d.ts", ".cloudflare/types/index.d.ts"]
}
